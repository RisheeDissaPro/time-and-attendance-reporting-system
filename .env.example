# Copy to .env and adjust. docker compose and the Python scripts both read it.
# Every value has a development default in docker-compose.yml, so
# `docker compose up` also works without a .env file. Change the passwords
# before using this anywhere other than a local machine.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=attendance_admin
POSTGRES_PASSWORD=change_me_attendance
POSTGRES_DB=attendance
# Host used by Python scripts run directly on your machine. Inside Docker
# the etl service always connects to the `postgres` service instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the postgres container is published on.
POSTGRES_HOST_PORT=5432
# Optional: full SQLAlchemy URL. When set, it overrides the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg2://attendance_admin:change_me_attendance@localhost:5432/attendance

# Read-only role Metabase uses to query attendance data.
METABASE_READER_PASSWORD=change_me_reader

# --- ETL ----------------------------------------------------------------
# Shifts longer than this many hours are flagged as overtime.
OVERTIME_THRESHOLD_HOURS=10
# Clock-in/clock-out more than this many minutes from the roster is a roster_breach.
ROSTER_TOLERANCE_MINUTES=30
# Standard 5-field cron expression for the nightly ETL (container local time).
ETL_CRON_SCHEDULE=0 2 * * *
DATA_DIR=./data
ATTENDANCE_CSV_PATH=./data/attendance_export.csv
LOG_LEVEL=INFO
# Timezone shared by postgres, etl (cron + sample data) and metabase.
TZ=UTC

# --- Metabase -----------------------------------------------------------
METABASE_PORT=3000
# SMTP for emailed reports and alerts. The defaults point at the optional
# mailpit container (`docker compose --profile mail up`), web UI on :8025.
MB_EMAIL_SMTP_HOST=mailpit
MB_EMAIL_SMTP_PORT=1025
MB_EMAIL_SMTP_SECURITY=none
MB_EMAIL_SMTP_USERNAME=
MB_EMAIL_SMTP_PASSWORD=
MB_EMAIL_FROM_ADDRESS=reports@securelock.example
